---
// Giscus (GitHub Discussions) comments. Rendered only when configured via
// public env vars, else renders nothing (Disqus remains the fallback).
// Set in .env: PUBLIC_GISCUS_REPO, PUBLIC_GISCUS_REPO_ID,
// PUBLIC_GISCUS_CATEGORY, PUBLIC_GISCUS_CATEGORY_ID
const repo = import.meta.env.PUBLIC_GISCUS_REPO;
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID;
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY;
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID;
const enabled = Boolean(repo && repoId && category && categoryId);
---

{enabled && (
  <div class="container m-auto mt-8">
    <script
      is:inline
      src="https://giscus.app/client.js"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-mapping="pathname"
      data-strict="0"
      data-reactions-enabled="1"
      data-emit-metadata="0"
      data-input-position="bottom"
      data-theme="preferred_color_scheme"
      data-lang="en"
      data-loading="lazy"
      crossorigin="anonymous"
      async
    ></script>
    <noscript>Enable JavaScript to view comments.</noscript>
  </div>
)}
