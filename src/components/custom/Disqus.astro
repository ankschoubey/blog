<div id="disqus_thread" class="container m-auto"></div>
<p class="container m-auto mt-2 text-sm text-muted">
  Comments lazy-load on scroll. Prefer GitHub? Giscus activates once
  <code>PUBLIC_GISCUS_*</code> env vars are set (see <code>Giscus.astro</code>).
</p>

<script is:inline>
  if (!window.DisqusWidget) {
    window.DisqusWidget = {
      loaded: false,
      init: function () {
        const target = document.querySelector('#disqus_thread');
        if (!target) return;
        // Lazy-load Disqus only when visible
        const load = () => {
          if (window.DisqusWidget.loaded) return;
          window.DisqusWidget.loaded = true;
          if (window.DISQUS) {
            window.DISQUS.reset({ reload: true });
            return;
          }
          const d = document,
            s = d.createElement('script');
          s.src = 'https://ankushchoubey.disqus.com/embed.js';
          s.setAttribute('data-timestamp', String(+new Date()));
          s.async = true;
          (d.head || d.body).appendChild(s);
        };
        if ('IntersectionObserver' in window) {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) {
                  load();
                  io.disconnect();
                }
              });
            },
            { rootMargin: '400px' }
          );
          io.observe(target);
        } else {
          load();
        }
        document.addEventListener('astro:after-swap', () => {
          window.DisqusWidget.loaded = false;
          window.DisqusWidget.init();
        });
      },
    };

    window.DisqusWidget.init();
  }
</script>

<noscript
  >Please enable JavaScript to view the <a href="https://disqus.com/?ref_noscript">comments powered by Disqus.</a
  ></noscript
