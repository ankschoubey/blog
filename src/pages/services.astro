---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Freelance Development Services | MVP Building & Feature Support',
  description: 'Hire a full-stack developer for MVPs, new features, and ongoing software support. Scalable, bug-free solutions for businesses.',
  robots: {
    index: true,
    follow: true,
  },
  openGraph: {
    type: 'website',
    url: 'https://www.ankushchoubey.com/services',
    title: 'Freelance Development Services | MVP Building & Feature Support',
    description: 'Hire a full-stack developer for MVPs, new features, and ongoing software support. Scalable, bug-free solutions for businesses.',
    site_name: 'Ankush Choubey',
  },
  twitter: {
    card: 'summary',
    site: '@ankushchoubey',
    title: 'Freelance Development Services | MVP Building & Feature Support',
    description: 'Hire a full-stack developer for MVPs, new features, and ongoing software support. Scalable, bug-free solutions for businesses.',
  },
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Freelance Full-Stack Developer"
    title="Full-Service Freelance Development: From MVP to Maintenance"
    subtitle="I handle everything—build MVPs, add features, deploy, and provide ongoing support with Spring Boot and React. Reliable, scalable solutions for businesses, delivered in 3–5 weeks for $2000–$5000."
    actions={[{ variant: 'primary', text: 'Get a Free Consultation', href: '/contact' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1461749280684-dccba630e2f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Freelance developer coding',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="My Development Services"
    subtitle="End-to-end service: I manage the full lifecycle, from initial development to deployment and long-term maintenance."
    columns={3}
    items={[
      {
        title: 'MVP Development',
        description:
          'Rapid prototyping and launch-ready MVPs using React/Spring Boot. Get to market fast with scalable architecture, including deployment and initial setup.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Feature Implementation',
        description:
          'Add new functionalities like APIs, UI/UX improvements, or integrations. Bug-free and optimized, with testing, deployment, and post-launch monitoring.',
        icon: 'tabler:plus',
      },
      {
        title: 'Ongoing Support & Maintenance',
        description:
          'Bug fixes, updates, performance optimizations—keep your software running smoothly indefinitely. Full lifecycle management post-deployment.',
        icon: 'tabler:settings',
      },
      {
        title: 'Consulting & Code Review',
        description:
          'Audit existing code, provide tech advice, or optimize for performance. Plus deployment guidance and maintenance planning.',
        icon: 'tabler:search',
      },
      {
        title: 'Custom Software Solutions',
        description:
          'Tailored apps for your business needs, from e-commerce to SaaS. Full project management from ideation to maintenance.',
        icon: 'tabler:code',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Fast Delivery',
        description:
          'MVP in weeks, not months. Agile development ensures quick turnaround without compromising quality.',
        icon: 'tabler:clock',
      },
      {
        title: 'Quality Assurance',
        description:
          'TDD and clean code practices guarantee bug-free, maintainable software that stands the test of time.',
        icon: 'tabler:check',
      },
      {
        title: 'Scalability',
        description:
          'Built for growth—architectures that handle increased users and features seamlessly.',
        icon: 'tabler:scale',
      },
      {
        title: 'Full Lifecycle Support',
        description:
          'From code to cloud—deployment, scaling, and maintenance included for end-to-end service.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Cost-Effective',
        description:
          'Freelance rates without overhead—professional results at competitive pricing.',
        icon: 'tabler:coin',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Benefits of freelance development services',
    }}
  >
    <Fragment slot="content">
      <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">Benefits</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Discovery & Planning',
        description:
          'Understand your requirements, goals, and technical needs through detailed consultation and project scoping.',
        icon: 'tabler:search',
      },
      {
        title: 'Development & Feature Building',
        description:
          'Build the core product using agile methodologies, with regular updates and iterations.',
        icon: 'tabler:code',
      },
      {
        title: 'Testing & QA',
        description:
          'Rigorous testing to ensure functionality, performance, and security before launch.',
        icon: 'tabler:check-circle',
      },
      {
        title: 'Deployment & Launch',
        description:
          'Deploy to production environments (cloud, servers) and ensure smooth launch.',
        icon: 'tabler:upload',
      },
      {
        title: 'Ongoing Maintenance & Support',
        description:
          'Post-launch support, bug fixes, updates, and scaling to keep your software evolving.',
        icon: 'tabler:refresh',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Development process overview',
    }}
  >
    <Fragment slot="content">
      <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">My End-to-End Process</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Pricing Range',
        description:
          '$2000–$5000 depending on project complexity (e.g., simple MVP vs. full feature set with integrations).',
        icon: 'tabler:dollar',
      },
      {
        title: 'Timeline',
        description:
          '3–5 weeks from start to deployment, with maintenance starting post-launch.',
        icon: 'tabler:calendar',
      },
      {
        title: 'What\'s Included',
        description:
          'Everything—development, deployment (e.g., AWS/Heroku), testing, and 3–6 months of free support.',
        icon: 'tabler:package',
      },
      {
        title: 'Payment Terms',
        description:
          'Milestone-based payments; 50% upfront, 50% on delivery.',
        icon: 'tabler:credit-card',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80',
      alt: 'Pricing and timeline details',
    }}
  >
    <Fragment slot="content">
      <h3 class="mb-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">Pricing & Timeline</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Client Testimonials"
    testimonials={[
      {
        testimonial: `Ankush delivered a scalable MVP on time, with clean code that made future updates easy. His full-service approach from deployment to maintenance was invaluable.`,
        name: 'Deepa Mandal',
        job: 'Senior Software Engineer',
        image: {
          src: '/recommendations/deepa-mandal-linkedin-profile-pic.jpeg',
          alt: 'Deepa Mandal',
        },
      },
      {
        testimonial: `His expertise in React and Spring Boot helped us build features quickly. The ongoing support ensured our app stayed bug-free and performant.`,
        name: 'Priya Jayachandran',
        job: 'Product Manager',
        image: {
          src: '/recommendations/priya-jayachandran-linkedin-profile-pic.jpeg',
          alt: 'Priya Jayachandran',
        },
      },
      {
        testimonial: `Reliable and professional—Ankush handled everything from ideation to deployment. Highly recommend for business software development.`,
        name: 'Umang Budhwar',
        job: 'Tech Entrepreneur',
        image: {
          src: '/recommendations/umang-budhwar-linkedin-profile-pic.jpeg',
          alt: 'Umang Budhwar',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'View on LinkedIn',
      href: 'https://www.linkedin.com/in/ankushchoubey/',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Contact Me',
        href: '/contact',
      },
    ]}
    title="Ready to Build or Enhance Your Software?"
    subtitle="Get started with a full-service solution for your business software needs. Let's discuss your project."
  />
</Layout>
