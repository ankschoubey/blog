---
import Layout from '~/layouts/PageLayout.astro';
import { getHomePermalink } from '~/utils/permalinks';
const title = `Error 404`;
---

<Layout metadata={{ title }}>
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-8">
    <div class="align-center container flex flex-col" style="width: 100%;">
      <span>
        <span class="p-2 text-3xl font-bold" style="padding-right: 0px;"
          ><span class="text-primary dark:text-blue-600">404</span>: Sorry, we couldn't find this page.</span
        >
      </span>
      <br />
      <div class="py-2">
        <form action="/search" method="get" class="flex max-w-md gap-2">
          <label for="q-404" class="sr-only">Search posts</label>
          <input
            id="q-404"
            name="q"
            type="search"
            placeholder="Search posts…"
            class="flex-1 rounded border px-3 py-2"
          />
          <button type="submit" class="rounded bg-primary px-4 py-2 text-white">Search</button>
        </form>
        <p class="mt-4"><a href={getHomePermalink()} class="text-primary hover:underline">Back home</a> · <a href="/blog" class="text-primary hover:underline">All posts</a></p>
      </div>
    </div>
  </section>
  <section class="flex h-full items-center p-16"></section>
</Layout>
