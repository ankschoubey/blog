---
import Layout from '~/layouts/PageLayout.astro';
import { LatencyGrid } from '~/components/custom/LatencyGrid';
import { entries, Unit } from '~/data/latency-entries';

const metadata = {
  title: 'Latency Numbers Every Programmer Should Know',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">Latency Numbers</h1>
    <p class="text-gray-500 mb-8">Every programmer should know</p>

    <LatencyGrid entries={entries} currentUnit={Unit.ns} label="ns" client:load />
    <LatencyGrid entries={entries} currentUnit={Unit.microS} label="μs" client:load />
    <LatencyGrid entries={entries} currentUnit={Unit.mS} label="ms" client:load />
  </section>
</Layout>
